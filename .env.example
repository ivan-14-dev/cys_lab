# Environment Configuration
# Copy this file to .env and adjust if needed
# All values here are fictitious lab-only values — NO REAL SECRETS

# --- Lab Network ---
LAB_NETWORK=lab-network

# --- Dashboard ---
DASHBOARD_PORT=8080

# --- Lab Ports ---
XSS_VULN_PORT=5001
XSS_SECURE_PORT=5002
CMD_VULN_PORT=5003
CMD_SECURE_PORT=5004
SSTI_VULN_PORT=5005
SSTI_SECURE_PORT=5006
NOSQL_VULN_PORT=5007
NOSQL_SECURE_PORT=5008
LDAP_VULN_PORT=5009
LDAP_SECURE_PORT=5010
XPATH_VULN_PORT=5011
XPATH_SECURE_PORT=5012
CSV_VULN_PORT=5013
CSV_SECURE_PORT=5014
LOG_VULN_PORT=5015
LOG_SECURE_PORT=5016
HEADER_VULN_PORT=5017
HEADER_SECURE_PORT=5018
EXPR_VULN_PORT=5019
EXPR_SECURE_PORT=5020

# --- MongoDB (internal only) ---
MONGO_PORT=27017
MONGO_DB=lab_nosql

# --- LDAP (internal only) ---
LDAP_PORT=389
LDAP_DOMAIN=lab.local
LDAP_ORG=InjectionLab
# Lab-only fictitious admin password — NOT a real credential
LDAP_ADMIN_PASSWORD=lab_admin_pass_123

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=lab-secret-key-not-for-production

# --- Resource Limits ---
MEM_LIMIT=256m
CPU_LIMIT=0.5
